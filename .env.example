# Shopify Storefront API
#
# Copy to .env.local and fill in. Without the first two values the site falls
# back to the placeholder catalog in src/lib/mock-products.ts, so a fresh clone
# still runs. See "Connecting Shopify" in README.md.

# Your store's myshopify domain (the admin domain, not a custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token from a custom app in the Shopify admin.
# This is the *public* storefront token — it is read-only and scoped to
# published products. Never put an Admin API token here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Defaults to the version in src/lib/shopify/config.ts.
# SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Optional. Seconds a cached Storefront response is served before Next
# revalidates it in the background. Defaults to 3600.
# SHOPIFY_REVALIDATE_SECONDS=3600

# Optional. Metafield holding the product spec table, as "namespace.key".
# Defaults to custom.specs.
# SHOPIFY_SPECS_METAFIELD=custom.specs

# Required only for the webhook at /api/shopify/revalidate. This is the
# webhook signing secret from the Shopify admin, used to verify the HMAC.
SHOPIFY_WEBHOOK_SECRET=
