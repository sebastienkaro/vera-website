# Shopify Storefront API credentials.
# Copy this file to .env.local and fill in the values for your store.
#
# Both come from the Shopify admin under Headless → Storefront API. The public
# access token is the one intended for storefront reads; it is only ever used
# server-side here, so it is not prefixed with NEXT_PUBLIC_ and never reaches
# the browser bundle.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Site editor (the `?edit` mode) ---
#
# All three are optional. Leave EDIT_PASSWORD unset and editing is off
# entirely, which is the right setting for any deploy that shouldn't be
# editable — a missing password locks the door rather than leaving it open.

# The single shared password handed to whoever edits the site. Changing it
# signs out every existing session.
EDIT_PASSWORD=

# Saves are committed back to the repository, which is what gives every edit a
# history entry and makes a bad change revertible. The token needs contents
# write access on this repo and nothing else — a fine-grained personal access
# token scoped to it is the narrowest option.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Defaults to main. Point it at a branch if you'd rather edits land there for
# review instead of going straight to the live site.
GITHUB_BRANCH=main

# --- HubSpot (the quote form and the chat widget) ---
#
# Both are optional and independent of each other. Neither value is a secret —
# the portal id ships in the page that loads the chat script, and the form
# submission endpoint takes no API key — so neither needs protecting, and
# neither is prefixed with NEXT_PUBLIC_ because both are read server-side.

# Vera's HubSpot account id — the number in any HubSpot URL for this account
# (app.hubspot.com/contacts/<portal id>). Left blank here on purpose: unset
# means no chat bubble loads at all, which is what a preview deploy wants,
# so this is set per-environment rather than defaulted on.
#
#   39763716
#
HUBSPOT_PORTAL_ID=

# The form quote requests land in. Vera's is "Request Price Form - Oct 2025":
#
#   72d73d93-44fc-4878-bbb9-dedd5cd24135
#
# Unset and /quote still renders, but submitting returns a message asking the
# visitor to call instead.
#
# The form has to define every field listed under "HubSpot" in the README —
# HubSpot rejects an entire submission that names a field its form doesn't
# have, rather than dropping that one value. Check the field list in the form
# editor before pointing a live site at a different form.
HUBSPOT_QUOTE_FORM_GUID=

# --- Approve (equipment financing on product pages) ---
#
# Approve (by Kwipped) quotes a monthly payment under the buy buttons and
# takes the finance application on their side. The account id is not a secret
# — it ships in the source of every page that offers financing, and Approve
# scopes it to the domains registered on the account — but it is read
# server-side like the HubSpot ids, so it isn't prefixed NEXT_PUBLIC_.
#
# Left blank here on purpose: unset means no financing button at all, which is
# what a preview deploy on a domain Approve has never heard of should show.
# Vera's account, the one the Webflow site uses:
#
#   eyJpdiI6Ik5KeStmdWM1eDd5T1kxeWRSU0hJMFE9PSIsInZhbHVlIjoib3ZjTHVSWSs5aXJLdnlCeFF0TXFUQT09IiwibWFjIjoiYTI2YmRjZjUwNjZlYTc5NzU5MmFiNDQ2ZmE0Yzg5MzI5NjM2MDM5NzRiYjUyNjRiM2NiNWYxYjQ4YjVjOWZmYSJ9
#
# The domain this site is deployed to has to be registered on that account
# before the button will quote anything — Approve refuses an id used from
# somewhere it doesn't recognise.
APPROVE_ID=
