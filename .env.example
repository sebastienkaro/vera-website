# Shopify Storefront API credentials.
# Copy this file to .env.local and fill in the values for your store.
#
# Both come from the Shopify admin under Headless → Storefront API. The public
# access token is the one intended for storefront reads; it is only ever used
# server-side here, so it is not prefixed with NEXT_PUBLIC_ and never reaches
# the browser bundle.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Site editor (the `?edit` mode) ---
#
# All three are optional. Leave EDIT_PASSWORD unset and editing is off
# entirely, which is the right setting for any deploy that shouldn't be
# editable — a missing password locks the door rather than leaving it open.

# The single shared password handed to whoever edits the site. Changing it
# signs out every existing session.
EDIT_PASSWORD=

# Saves are committed back to the repository, which is what gives every edit a
# history entry and makes a bad change revertible. The token needs contents
# write access on this repo and nothing else — a fine-grained personal access
# token scoped to it is the narrowest option.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Defaults to main. Point it at a branch if you'd rather edits land there for
# review instead of going straight to the live site.
GITHUB_BRANCH=main

# --- HubSpot (the quote form and the chat widget) ---
#
# Both are optional and independent of each other. Neither value is a secret —
# the portal id ships in the page that loads the chat script, and the form
# submission endpoint takes no API key — so neither needs protecting, and
# neither is prefixed with NEXT_PUBLIC_ because both are read server-side.

# Your HubSpot account id, from Settings → Account Setup → Account Defaults, or
# the number in any HubSpot URL (app.hubspot.com/contacts/<portal id>). Unset
# and the chat bubble doesn't load at all, which is the right setting for a
# preview deploy that shouldn't put a live support channel in front of anyone.
HUBSPOT_PORTAL_ID=

# The form the quote page posts to, from the form's Share → Embed code in
# HubSpot, or the guid in its editor URL. Unset and /quote still renders, but
# submitting returns a message asking the visitor to call instead.
HUBSPOT_QUOTE_FORM_GUID=
